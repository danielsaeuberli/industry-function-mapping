######################################################################
# Layer 2a - CBF categories (mapping target)
######################################################################

cbf:CBF-CORE
    a skos:Concept ;
    skos:inScheme scheme:cbf ;
    skos:topConceptOf scheme:cbf ;
    skos:prefLabel "Core business function"@en ;
    skos:definition "The production of the goods or services intended for the market that constitute the enterprise's primary output. Core vs. support is relative to the enterprise, not to the activity."@en ;
    ifm:codeStatus "provisional" .

cbf:CBF-SUP
    a skos:Concept ;
    skos:inScheme scheme:cbf ;
    skos:topConceptOf scheme:cbf ;
    skos:prefLabel "Support business functions"@en ;
    skos:definition "Ancillary activities carried out to permit or facilitate the core function."@en ;
    ifm:codeStatus "provisional" .

cbf:CBF-SUP-DIST
    a skos:Concept ;
    skos:inScheme scheme:cbf ;
    skos:prefLabel "Distribution and logistics"@en ;
    skos:broader cbf:CBF-SUP ;
    skos:definition "Transport, warehousing, order handling."@en ;
    ifm:codeStatus "provisional" .

cbf:CBF-SUP-MKT
    a skos:Concept ;
    skos:inScheme scheme:cbf ;
    skos:prefLabel "Marketing, sales and after-sales services"@en ;
    skos:broader cbf:CBF-SUP ;
    skos:definition "Including help desks and call centres."@en ;
    ifm:codeStatus "provisional" .

cbf:CBF-SUP-ICT
    a skos:Concept ;
    skos:inScheme scheme:cbf ;
    skos:prefLabel "ICT services"@en ;
    skos:broader cbf:CBF-SUP ;
    skos:definition "Operating and maintaining information and communication systems."@en ;
    ifm:codeStatus "provisional" .

cbf:CBF-SUP-ADM
    a skos:Concept ;
    skos:inScheme scheme:cbf ;
    skos:prefLabel "Administrative and management functions"@en ;
    skos:broader cbf:CBF-SUP ;
    skos:definition "Legal, accounting, finance, human resources, general management, compliance."@en ;
    ifm:codeStatus "provisional" .

cbf:CBF-SUP-ENG
    a skos:Concept ;
    skos:inScheme scheme:cbf ;
    skos:prefLabel "Engineering and related technical services"@en ;
    skos:broader cbf:CBF-SUP ;
    skos:definition "Technical testing, design, engineering support."@en ;
    ifm:codeStatus "provisional" .

cbf:CBF-SUP-RND
    a skos:Concept ;
    skos:inScheme scheme:cbf ;
    skos:prefLabel "Research and development"@en ;
    skos:broader cbf:CBF-SUP ;
    ifm:codeStatus "provisional" .

cbf:CBF-SUP-OTH
    a skos:Concept ;
    skos:inScheme scheme:cbf ;
    skos:prefLabel "Other support business functions"@en ;
    skos:broader cbf:CBF-SUP ;
    ifm:codeStatus "provisional" .

######################################################################
# Layer 2b - APQC PCF categories (mapping target)
######################################################################

apqc:apqc-3.0
    a skos:Concept ;
    skos:inScheme scheme:apqc-pcf ;
    skos:topConceptOf scheme:apqc-pcf ;
    skos:prefLabel "Market and Sell Products and Services"@en ;
    skos:notation "3.0" ;
    ifm:codeStatus "provisional" ;
    skos:scopeNote "Cross-industry PCF category. Only the categories referenced by an alignment are carried here; the full framework is licensed by APQC and must be obtained from apqc.org."@en .

apqc:apqc-6.0
    a skos:Concept ;
    skos:inScheme scheme:apqc-pcf ;
    skos:topConceptOf scheme:apqc-pcf ;
    skos:prefLabel "Manage Customer Service"@en ;
    skos:notation "6.0" ;
    ifm:codeStatus "provisional" .

apqc:apqc-7.0
    a skos:Concept ;
    skos:inScheme scheme:apqc-pcf ;
    skos:topConceptOf scheme:apqc-pcf ;
    skos:prefLabel "Develop and Manage Human Capital"@en ;
    skos:notation "7.0" ;
    ifm:codeStatus "provisional" .

apqc:apqc-8.0
    a skos:Concept ;
    skos:inScheme scheme:apqc-pcf ;
    skos:topConceptOf scheme:apqc-pcf ;
    skos:prefLabel "Manage Information Technology"@en ;
    skos:notation "8.0" ;
    ifm:codeStatus "provisional" .

apqc:apqc-11.0
    a skos:Concept ;
    skos:inScheme scheme:apqc-pcf ;
    skos:topConceptOf scheme:apqc-pcf ;
    skos:prefLabel "Manage Enterprise Risk, Compliance, Remediation, and Resiliency"@en ;
    skos:notation "11.0" ;
    ifm:codeStatus "provisional" .

######################################################################
# Layer 2c - Operational business functions (+ alignments)
######################################################################

func:identity-proofing
    a ifm:BusinessFunction, skos:Concept ;
    skos:inScheme scheme:ifm-functions ;
    skos:topConceptOf scheme:ifm-functions ;
    skos:prefLabel "Identity proofing"@en ;
    skos:definition "Establishing to a stated level of assurance that a claimed identity corresponds to a real subject."@en ;
    skos:narrower func:identity-lifecycle-management ;
    skos:broadMatch cbf:CBF-SUP-ADM ;
    skos:relatedMatch apqc:apqc-11.0 ;
    skos:editorialNote "Administrative where it is a gate on a relationship; becomes core for identity service providers."@en .

func:customer-onboarding
    a ifm:BusinessFunction, skos:Concept ;
    skos:inScheme scheme:ifm-functions ;
    skos:topConceptOf scheme:ifm-functions ;
    skos:prefLabel "Customer onboarding"@en ;
    skos:definition "Establishing a new customer or member relationship, including the due diligence that regulation attaches to it."@en ;
    skos:broadMatch cbf:CBF-SUP-MKT ;
    skos:relatedMatch apqc:apqc-3.0 .

func:identity-lifecycle-management
    a ifm:BusinessFunction, skos:Concept ;
    skos:inScheme scheme:ifm-functions ;
    skos:prefLabel "Identity lifecycle management"@en ;
    skos:definition "Maintaining an established identity relationship over time: re-verification, recovery, attribute updates, revocation."@en ;
    skos:broader func:identity-proofing ;
    skos:broadMatch cbf:CBF-SUP-ADM .

func:eligibility-verification
    a ifm:BusinessFunction, skos:Concept ;
    skos:inScheme scheme:ifm-functions ;
    skos:topConceptOf scheme:ifm-functions ;
    skos:prefLabel "Eligibility verification"@en ;
    skos:definition "Checking whether a subject meets a stated condition — age, residency, licence, membership — without necessarily identifying them."@en ;
    skos:broadMatch cbf:CBF-SUP-ADM .

func:access-management
    a ifm:BusinessFunction, skos:Concept ;
    skos:inScheme scheme:ifm-functions ;
    skos:topConceptOf scheme:ifm-functions ;
    skos:prefLabel "Access management"@en ;
    skos:definition "Granting, restricting and revoking access to systems, premises or services."@en ;
    skos:broadMatch cbf:CBF-SUP-ICT ;
    skos:relatedMatch apqc:apqc-8.0 .

func:certification-and-attestation
    a ifm:BusinessFunction, skos:Concept ;
    skos:inScheme scheme:ifm-functions ;
    skos:topConceptOf scheme:ifm-functions ;
    skos:prefLabel "Certification and attestation"@en ;
    skos:definition "Issuing an authoritative statement about a subject, a product or a process — a diploma, a certificate, an accreditation."@en ;
    skos:broadMatch cbf:CBF-CORE ;
    skos:editorialNote "Core for schools, laboratories and certification bodies; support elsewhere. See README on the core/support relativity."@en .

func:regulatory-compliance
    a ifm:BusinessFunction, skos:Concept ;
    skos:inScheme scheme:ifm-functions ;
    skos:topConceptOf scheme:ifm-functions ;
    skos:prefLabel "Regulatory compliance"@en ;
    skos:definition "Meeting statutory and regulatory obligations, including record-keeping and supervisory reporting."@en ;
    skos:broadMatch cbf:CBF-SUP-ADM ;
    skos:relatedMatch apqc:apqc-11.0 .

func:sourcing-and-procurement
    a ifm:BusinessFunction, skos:Concept ;
    skos:inScheme scheme:ifm-functions ;
    skos:topConceptOf scheme:ifm-functions ;
    skos:prefLabel "Sourcing and procurement"@en ;
    skos:definition "Selecting, qualifying and contracting suppliers, and running the purchase-to-pay process."@en ;
    skos:narrower func:supply-chain-traceability ;
    skos:broadMatch cbf:CBF-SUP-DIST ;
    skos:editorialNote "CBF has no separate procurement category; distribution and logistics is the closest fit."@en .

func:supply-chain-traceability
    a ifm:BusinessFunction, skos:Concept ;
    skos:inScheme scheme:ifm-functions ;
    skos:prefLabel "Supply chain traceability"@en ;
    skos:definition "Establishing provenance and chain of custody for goods and their inputs."@en ;
    skos:broader func:sourcing-and-procurement ;
    skos:broadMatch cbf:CBF-SUP-DIST .

func:human-capital-management
    a ifm:BusinessFunction, skos:Concept ;
    skos:inScheme scheme:ifm-functions ;
    skos:topConceptOf scheme:ifm-functions ;
    skos:prefLabel "Human capital management"@en ;
    skos:definition "Hiring, employing and offboarding people, and administering their qualifications and entitlements."@en ;
    skos:broadMatch cbf:CBF-SUP-ADM ;
    skos:relatedMatch apqc:apqc-7.0 .

func:customer-service
    a ifm:BusinessFunction, skos:Concept ;
    skos:inScheme scheme:ifm-functions ;
    skos:topConceptOf scheme:ifm-functions ;
    skos:prefLabel "Customer service"@en ;
    skos:definition "Handling requests, incidents and complaints from an existing customer relationship."@en ;
    skos:broadMatch cbf:CBF-SUP-MKT ;
    skos:relatedMatch apqc:apqc-6.0 .

func:service-delivery
    a ifm:BusinessFunction, skos:Concept ;
    skos:inScheme scheme:ifm-functions ;
    skos:topConceptOf scheme:ifm-functions ;
    skos:prefLabel "Service delivery"@en ;
    skos:definition "Performing and delivering the service the organisation exists to provide."@en ;
    skos:broadMatch cbf:CBF-CORE .

func:records-management
    a ifm:BusinessFunction, skos:Concept ;
    skos:inScheme scheme:ifm-functions ;
    skos:topConceptOf scheme:ifm-functions ;
    skos:prefLabel "Records management"@en ;
    skos:definition "Maintaining an authoritative register or record and answering queries against it."@en ;
    skos:broadMatch cbf:CBF-SUP-ADM .

######################################################################
# Layer 3 - Use cases (sector x function intersection nodes)
######################################################################

uc:banking-kyc-onboarding
    a ifm:UseCase, schema:Action ;
    schema:name "Online onboarding and KYC credential issuance"@en ;
    schema:description "A prospective customer opens a bank account remotely. The bank identifies them against the e-ID and issues a reusable KYC attestation."@en ;
    ifm:appliesToSector sector:ISIC-K-6419, sector:ISIC-K-6512 ;
    ifm:primaryFunction func:customer-onboarding ;
    ifm:executesFunction func:identity-proofing, func:regulatory-compliance ;
    ifm:sectorScope ifm:SectorSpecific ;
    ifm:maturity ifm:Modelled ;
    ifm:documentedBy <https://github.com/DIDAS-swiss/Trust-Flow-Diagram-Repository/tree/main/banking/KYC%20Credential> .

uc:banking-re-kyc
    a ifm:UseCase, schema:Action ;
    schema:name "Periodic KYC re-evaluation"@en ;
    schema:description "The bank re-runs customer due diligence on an existing relationship at the interval its supervisor requires, reusing the identity already established."@en ;
    ifm:appliesToSector sector:ISIC-K-6419 ;
    ifm:primaryFunction func:regulatory-compliance ;
    ifm:executesFunction func:identity-lifecycle-management ;
    ifm:sectorScope ifm:SectorSpecific ;
    ifm:maturity ifm:Modelled ;
    ifm:documentedBy <https://github.com/DIDAS-swiss/Trust-Flow-Diagram-Repository/tree/main/banking/KYC%20Credential> .

uc:banking-reidentification-password-reset
    a ifm:UseCase, schema:Action ;
    schema:name "Re-identification after a forgotten password"@en ;
    schema:description "An existing e-banking customer who has lost their credentials is re-identified before access is restored, without a branch visit."@en ;
    ifm:appliesToSector sector:ISIC-K-6419 ;
    ifm:primaryFunction func:identity-lifecycle-management ;
    ifm:executesFunction func:customer-service, func:access-management ;
    ifm:sectorScope ifm:SectorSpecific ;
    ifm:maturity ifm:Modelled ;
    ifm:documentedBy <https://github.com/DIDAS-swiss/Trust-Flow-Diagram-Repository/tree/main/banking/Re-Identification%20After%20Forgotten%20Password> .

uc:banking-age-of-majority-reidentification
    a ifm:UseCase, schema:Action ;
    schema:name "Re-identification at the age of majority"@en ;
    schema:description "A customer onboarded as a minor turns 18. The relationship is re-established at full legal capacity, with a qualified electronic signature."@en ;
    ifm:appliesToSector sector:ISIC-K-6419 ;
    ifm:primaryFunction func:identity-lifecycle-management ;
    ifm:executesFunction func:regulatory-compliance ;
    ifm:sectorScope ifm:SectorSpecific ;
    ifm:maturity ifm:Modelled ;
    ifm:documentedBy <https://github.com/DIDAS-swiss/Trust-Flow-Diagram-Repository/tree/main/banking/Re-Identification%20at%20Age%20of%20Majority> .

uc:education-maturitaetszeugnis-issuance
    a ifm:UseCase, schema:Action ;
    schema:name "Issuance of a Maturitätszeugnis"@en ;
    schema:description "An upper-secondary school issues the school-leaving certificate to the graduate as a digital attestation."@en ;
    ifm:appliesToSector sector:ISIC-P-8521 ;
    ifm:primaryFunction func:certification-and-attestation ;
    ifm:executesFunction func:records-management ;
    ifm:sectorScope ifm:SectorSpecific ;
    ifm:maturity ifm:Modelled ;
    ifm:documentedBy <https://github.com/DIDAS-swiss/Trust-Flow-Diagram-Repository/tree/main/education> .

uc:education-university-immatriculation
    a ifm:UseCase, schema:Action ;
    schema:name "University immatriculation"@en ;
    schema:description "A university admits a student on the strength of the e-ID and the Maturitätszeugnis, without re-collecting or re-checking paper documents."@en ;
    ifm:appliesToSector sector:ISIC-P-8530 ;
    ifm:primaryFunction func:customer-onboarding ;
    ifm:executesFunction func:eligibility-verification, func:identity-proofing ;
    ifm:sectorScope ifm:SectorSpecific ;
    ifm:maturity ifm:Modelled ;
    ifm:documentedBy <https://github.com/DIDAS-swiss/Trust-Flow-Diagram-Repository/tree/main/education> .

uc:retail-hospitality-age-verification
    a ifm:UseCase, schema:Action ;
    schema:name "Age verification at the point of sale"@en ;
    schema:description "A merchant or a restaurant checks that a customer is over the legal age for a restricted product, learning nothing else about them."@en ;
    ifm:appliesToSector sector:ISIC-G-4711, sector:ISIC-I-5610 ;
    ifm:primaryFunction func:eligibility-verification ;
    ifm:executesFunction func:regulatory-compliance ;
    ifm:sectorScope ifm:CrossSector ;
    ifm:maturity ifm:Exploratory .

uc:employment-identity-proofing
    a ifm:UseCase, schema:Action ;
    schema:name "Employee identity proofing and onboarding"@en ;
    schema:description "An employer identifies a new hire and checks the qualifications the role requires, before provisioning any account."@en ;
    ifm:appliesToSector sector:ISIC-C, sector:ISIC-J, sector:ISIC-K, sector:ISIC-P, sector:ISIC-Q ;
    ifm:primaryFunction func:human-capital-management ;
    ifm:executesFunction func:identity-proofing, func:eligibility-verification ;
    ifm:sectorScope ifm:CrossSector ;
    ifm:maturity ifm:Exploratory .

uc:aerospace-supplier-onboarding
    a ifm:UseCase, schema:Action ;
    schema:name "Automated aerospace supplier onboarding"@en ;
    schema:description "A manufacturer qualifies a new supplier by checking its legal existence, its signatories and its quality accreditations."@en ;
    ifm:appliesToSector sector:ISIC-C-3030 ;
    ifm:primaryFunction func:sourcing-and-procurement ;
    ifm:executesFunction func:supply-chain-traceability, func:regulatory-compliance ;
    ifm:sectorScope ifm:SectorSpecific ;
    ifm:maturity ifm:Exploratory .

uc:healthcare-patient-identification
    a ifm:UseCase, schema:Action ;
    schema:name "Patient identification at admission"@en ;
    schema:description "A hospital identifies a patient at admission and links them to the right record."@en ;
    ifm:appliesToSector sector:ISIC-Q-8610 ;
    ifm:primaryFunction func:service-delivery ;
    ifm:executesFunction func:identity-proofing, func:records-management ;
    ifm:sectorScope ifm:SectorSpecific ;
    ifm:maturity ifm:Exploratory .

uc:egov-service-access
    a ifm:UseCase, schema:Action ;
    schema:name "Access to an online government service"@en ;
    schema:description "A resident authenticates to a public-administration service portal and proves the attributes the service is entitled to see."@en ;
    ifm:appliesToSector sector:ISIC-O-8411 ;
    ifm:primaryFunction func:access-management ;
    ifm:executesFunction func:identity-proofing, func:service-delivery ;
    ifm:sectorScope ifm:SectorSpecific ;
    ifm:maturity ifm:Exploratory .
